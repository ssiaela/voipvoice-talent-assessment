# Copia questo file in .env per l'uso locale.
# NON inserire mai .env nel repository.

# Obbligatoria al PRIMO avvio. Minimo 12 caratteri.
VV_INITIAL_PASSWORD=

# Indirizzo di ascolto del server.
VV_HOST=0.0.0.0

# Porta locale. Molti hosting impostano automaticamente PORT e hanno precedenza.
VV_PORT=8087

# URL pubblico usato nei link candidati. In locale puoi lasciarlo vuoto.
# Esempio: https://assessment.voipvoice.it
VV_PUBLIC_BASE_URL=

# Percorso del database SQLite. La cartella viene creata automaticamente.
VV_DB_PATH=data/talent.db

# Durata della sessione HR in ore.
VV_SESSION_HOURS=8
